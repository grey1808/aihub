# ==========================================================================
#  Корпоративный ИИ-помощник — настройки
#  Скопируйте этот файл в .env и поправьте под свою установку.
# ==========================================================================

APP_NAME="ИИ-помощник"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru

# Адрес, по которому сотрудники открывают помощника с других компьютеров.
# Подставьте сюда IP или имя моноблока в сети.
APP_URL=http://localhost:8080
APP_PORT=8080

# HTTPS во внутренней сети. Нужен для записи голосовых: браузеры дают
# микрофон только на защищённых страницах. Сертификат самоподписанный,
# его создаёт deploy/make-cert.sh — браузер один раз покажет предупреждение.
ENABLE_HTTPS=false
APP_SSL_PORT=8443

# --------------------------------------------------------------------------
#  Автозапуск при включении компьютера
# --------------------------------------------------------------------------
# true  — на моноблоке: приложение и нейросеть поднимаются сами при загрузке.
# false — на машине разработчика: запускаем руками, когда нужно.
# Значение читает установщик deploy/install.sh, который ставит systemd-юнит.
AUTOSTART_ON_BOOT=false

# --------------------------------------------------------------------------
#  Нейросеть
# --------------------------------------------------------------------------
# ollama   — сервис в докере, поднимается вместе с приложением (рекомендуется)
# lmstudio — LM Studio, запущенная на самом компьютере
LLM_DRIVER=ollama

# Для ollama:   http://ollama:11434/v1
# Для lmstudio: http://host.docker.internal:1234/v1
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama

# Модель для диалога. На моноблоке со 128 ГБ разумно qwen3:32b.
# На слабой машине для проверки: qwen3:4b.
LLM_MODEL=qwen3:32b

# Где считать вектора для базы знаний.
#
# Пусто — там же, где идёт диалог. Но если диалог работает на LM Studio,
# так делать не стоит: она обрабатывает запросы по одному, и индексация
# документов будет надолго занимать очередь, пока люди ждут ответа в чате.
# Тогда поднимаем рядом Ollama только под вектора:
#   LLM_EMBEDDING_BASE_URL=http://ollama:11434/v1
LLM_EMBEDDING_BASE_URL=
LLM_EMBEDDING_API_KEY=

# Модель для поиска по документам. Менять только вместе с переиндексацией.
LLM_EMBEDDING_MODEL=bge-m3
LLM_EMBEDDING_DIMENSIONS=1024

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=600

# Сколько запросов к модели обрабатывать одновременно.
# Больше 2-3 на одной машине смысла не имеет — только очередь длиннее.
LLM_MAX_CONCURRENT=2
LLM_MAX_TOOL_ITERATIONS=6

# -1 — держать модель в памяти всегда, чтобы никто не ждал её загрузку.
OLLAMA_KEEP_ALIVE=-1

# Сколько текста модель видит за раз. По умолчанию Ollama даёт 4096 токенов,
# и найденные документы в это окно не влезают — обрезаются молча.
# 16384 хватает с запасом. Больше — если увеличите RAG_TOP_K или RAG_CHUNK_SIZE.
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_NUM_PARALLEL=2

# --------------------------------------------------------------------------
#  База знаний
# --------------------------------------------------------------------------
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=6
RAG_MIN_SCORE=0.35
RAG_AUTO_CONTEXT=true

# Папка с документами компании на самом компьютере. Внутри приложения
# она будет видна как /data/documents — этот путь и указываем в админке.
DOCUMENTS_PATH=./storage/app/documents

# --------------------------------------------------------------------------
#  Вложения в чате: файлы, картинки, голосовые
# --------------------------------------------------------------------------
ATTACHMENT_MAX_SIZE=33554432
ATTACHMENT_MAX_PER_MESSAGE=5
ATTACHMENT_MAX_TEXT_CHARS=12000
ATTACHMENT_ORPHAN_LIFETIME_HOURS=24

# Модель, умеющая смотреть картинки. Пусто — картинки приниматься будут,
# но помощник честно скажет, что посмотреть их нечем.
# Для моноблока: LLM_VISION_MODEL=qwen2.5vl:7b (docker compose exec ollama ollama pull qwen2.5vl:7b)
LLM_VISION_MODEL=

# Распознавание голосовых. Поднимается профилем with-whisper.
STT_ENABLED=true
STT_BASE_URL=http://whisper:8000/v1
STT_MODEL=Systran/faster-whisper-small
STT_LANGUAGE=ru
STT_TIMEOUT=300

# --------------------------------------------------------------------------
#  Учётная запись администратора (создаётся при первом запуске)
# --------------------------------------------------------------------------
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@localhost

# --------------------------------------------------------------------------
#  База данных и служебные сервисы
# --------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=aihub
DB_USERNAME=aihub
DB_PASSWORD=aihub

SESSION_DRIVER=database
SESSION_LIFETIME=480

QUEUE_CONNECTION=database
CACHE_STORE=redis

REDIS_HOST=redis
REDIS_PORT=6379

LOG_CHANNEL=stack
LOG_LEVEL=info

# Идентификаторы пользователя, от имени которого работают контейнеры.
# Узнать свои: id -u и id -g
WWWUSER=1000
WWWGROUP=1000
