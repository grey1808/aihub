# Окружение для автотестов. Laravel подхватывает этот файл, когда APP_ENV=testing.
# Файл намеренно лежит в репозитории: секретов в нём нет, а без него тесты
# пошли бы по боевой базе.

APP_ENV=testing
APP_KEY=base64:2fl+Ktp4rNUpxS2eKVbY8Lkm0aUOPTDCE1L8Iu5Vq7c=
APP_DEBUG=true
APP_URL=http://localhost

# Тесты идут на Postgres: база знаний живёт на расширении pgvector,
# которого в sqlite нет. Отдельная база, чтобы не стереть рабочие данные.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=aihub_testing
DB_USERNAME=aihub
DB_PASSWORD=aihub

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4

# В тестах к нейросети не ходим.
RAG_AUTO_CONTEXT=false
LLM_EMBEDDING_DIMENSIONS=384
